# =============================================
# Environment Variables Example
# =============================================
# Copy this file to `.env` and fill in real values.
# `.env` is gitignored; only `.env.example` is committed.
# DO NOT commit real secrets to the repository.

# Application
NODE_ENV=development
PORT=3000

# CORS origin(s) allowed to call the API (comma-separated for multiple)
CORS_ORIGIN=http://localhost:5173

# MySQL database connection
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=<REPLACE_WITH_YOUR_MYSQL_PASSWORD>
MYSQL_DATABASE=node_template
MYSQL_PORT=3306

# JWT (RSA, RS256)
# Generate a key pair with:
#   openssl genpkey -algorithm RSA -out jwt_private.pem -pkeyopt rsa_keygen_bits:2048
#   openssl rsa -in jwt_private.pem -pubout -out jwt_public.pem
# Paste the contents of each file (including BEGIN/END lines) as a single line value,
# or use the multiline convention supported by your loader.
JWT_PUBLIC_KEY=<REPLACE_WITH_YOUR_RSA_PUBLIC_KEY>
JWT_PRIVATE_KEY=<REPLACE_WITH_YOUR_RSA_PRIVATE_KEY>

# Token lifetimes and metadata (in seconds for JWT_EXPIRY_TIME)
JWT_EXPIRY_TIME=3600
JWT_ISSUER=issuer
JWT_AUDIENCE=audience